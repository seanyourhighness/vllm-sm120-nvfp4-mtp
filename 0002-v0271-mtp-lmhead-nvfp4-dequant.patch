+    @staticmethod
+    def _dequant_nvfp4_packed_weight(
+        packed: torch.Tensor,
+        weight_scale: torch.Tensor,
+        weight_scale_2: torch.Tensor | None,
+        block_size: int,
+    ) -> torch.Tensor:
+        """Dequantize an NVFP4-packed tensor to BF16.
+
+        packed: uint8 [*, N/2] (two FP4 nibbles per byte)
+        weight_scale: float8_e4m3 [*, N/block_size] per-block scales
+        weight_scale_2: optional scalar global scale
+        """
+        assert packed.dtype == torch.uint8, packed.dtype
+        low = (packed & 0x0F).to(torch.int16)
+        high = ((packed >> 4) & 0x0F).to(torch.int16)
+
+        def nibbles_to_fp4e2m1(nib: torch.Tensor) -> torch.Tensor:
+            # E2M1 decode: sign bit + 3-bit magnitude code
+            # codes: 0->0.0, 1->0.5, 2->1.0, 3->1.5, 4->2.0, 5->3.0, 6->4.0, 7->6.0
+            sign = torch.where((nib & 0x8) == 0, 1.0, -1.0)
+            code = (nib & 0x7).to(torch.int64)
+            lut = torch.tensor(
+                [0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0],
+                dtype=torch.float32,
+                device=nib.device,
+            )
+            return sign * lut[code]
+
+        vals = torch.stack(
+            [nibbles_to_fp4e2m1(low), nibbles_to_fp4e2m1(high)], dim=-1
+        ).reshape(*packed.shape[:-1], packed.shape[-1] * 2)
+        vals = vals.to(torch.float32)
+
+        scales = weight_scale.to(torch.float32)
+        if weight_scale_2 is not None:
+            scales = scales * weight_scale_2.to(torch.float32)
+
+        # broadcast [*, N/bs] scales over each block of bs elements
+        expanded = scales.repeat_interleave(block_size, dim=-1)
+        return (vals * expanded)[..., : vals.shape[-1]].to(torch.bfloat16)
+
     def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]) -> set[str]:
+        quant_name = (
+            self.quant_config.get_name() if self.quant_config is not None else ""
+        )
+
+        # NVFP4 lm_head hardening (issue #4): NVFP4 exports may serialize the
+        # MTP drafter's lm_head as a packed uint8 weight plus per-block scale
+        # tensors, while the drafter builds an unquantized ParallelLMHead.
+        # Detect that layout and dequantize to BF16 at load; BF16 checkpoints
+        # (the pinned revision) pass through untouched on the fast path.
+        if not self.config.tie_word_embeddings and quant_name == "modelopt_fp4":
+            hf_qc = getattr(self.config, "quantization_config", None) or {}
+            block_size = int(
+                hf_qc.get("block_size", hf_qc.get("weight_block_size", 16)) or 16
+            )
+
+            # We need the actual tensors, so materialize the packed buffer
+            # rather than relying on generator pass-through. Scales may be
+            # emitted before OR after the packed weight, so both are staged
+            # and matched by their common key at stream end.
+            def hardened(inner):
+                packed: dict[str, torch.Tensor] = {}
+                scales: dict[str, dict[str, torch.Tensor]] = {}
+                for name, weight in inner:
+                    short = name.split("/")[-1]
+                    if "lm_head" in short:
+                        if short.endswith("input_scale"):
+                            # activation scale: unused for an unquantized head
+                            continue
+                        if short.endswith("weight_scale_2"):
+                            scales.setdefault(name.rsplit(".", 1)[0], {})[
+                                "global"
+                            ] = weight
+                            continue
+                        if short.endswith("weight_scale"):
+                            scales.setdefault(name.rsplit(".", 1)[0], {})[
+                                "block"
+                            ] = weight
+                            continue
+                        if weight.dtype == torch.uint8:
+                            packed[name] = weight
+                            continue
+                    yield name, weight
+
+                for name, pw in packed.items():
+                    key = name.rsplit(".", 1)[0]
+                    sc = scales.get(key, {})
+                    if "block" not in sc:
+                        raise ValueError(
+                            f"NVFP4-packed {name} without weight_scale; "
+                            "refusing to load garbage into the MTP head"
+                        )
+                    logger.info(
+                        "MTP lm_head %s: NVFP4-packed %s -> dequantizing to BF16",
+                        name,
+                        tuple(pw.shape),
+                    )
+                    dq = self._dequant_nvfp4_packed_weight(
+                        pw,
+                        sc["block"],
+                        sc.get("global"),
+                        block_size,
+                    )
+                    expected = (self.config.vocab_size, self.config.hidden_size)
+                    if tuple(dq.shape) != expected:
+                        raise ValueError(
+                            f"dequantized lm_head shape {tuple(dq.shape)} != "
+                            f"{expected}; checkpoint export is inconsistent"
+                        )
+                    yield name, dq
+
+            weights = hardened(weights)
+
