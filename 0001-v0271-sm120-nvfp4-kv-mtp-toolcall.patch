+def _make_xqa_spec_decode_mask(
+    batch_size: int,
+    q_len_per_req: int,
+    device: torch.device,
+) -> torch.Tensor:
+    """Build XQA's uint16 bit-packed causal mask for uniform MTP verify."""
+    num_words = (q_len_per_req + 31) // 32
+    query_positions = torch.arange(
+        q_len_per_req, dtype=torch.int64, device=device
+    ).unsqueeze(1)
+    key_positions = torch.arange(
+        q_len_per_req, dtype=torch.int64, device=device
+    ).unsqueeze(0)
+    causal_mask = key_positions <= query_positions
+    padded_q_len = num_words * 32
+    if padded_q_len > q_len_per_req:
+        causal_mask = torch.nn.functional.pad(
+            causal_mask, (0, padded_q_len - q_len_per_req)
+        )
+    causal_mask = causal_mask.view(q_len_per_req, num_words, 32)
+    bit_positions = 1 << torch.arange(32, dtype=torch.int64, device=device)
+    packed_u32 = (
+        (causal_mask.to(torch.int64) * bit_positions).sum(dim=-1).to(torch.uint32)
+    )
+    return (
+        packed_u32.unsqueeze(0)
+        .expand(batch_size, q_len_per_req, num_words)
+        .contiguous()
+        .view(torch.uint16)
+    )
+
